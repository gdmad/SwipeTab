{
  "manifest_version": 2,
  "name": "SwipeTab",
  "version": "1.0.0",
  "description": "Trackpad and mouse gesture control for tabs: swipe to switch, close, and restore tabs, right-click to open links in the background.",

  "browser_specific_settings": {
    "gecko": {
      "id": "swipetab@evgeny.local",
      "strict_min_version": "115.0"
    }
  },

  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },

  "permissions": ["tabs", "sessions", "<all_urls>"],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
